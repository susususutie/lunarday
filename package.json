{
  "name": "lunarday",
  "version": "1.1.0",
  "type": "module",
  "description": "农历生日日历生成器 - 将农历生日转换为公历日期，生成 Apple Calendar 兼容的 .ics 文件",
  "main": "./dist/cli.mjs",
  "bin": {
    "lunarday": "./dist/cli.mjs"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "pack": "vp pack",
    "preview": "vp preview",
    "check": "vp check",
    "test": "node bin/cli.js --help"
  },
  "keywords": [
    "lunar",
    "calendar",
    "birthday",
    "apple-calendar",
    "ics",
    "chinese-calendar",
    "农历",
    "生日"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/susususutie/lunarday.git"
  },
  "bugs": {
    "url": "https://github.com/susususutie/lunarday/issues"
  },
  "homepage": "https://github.com/susususutie/lunarday#readme",
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "commander": "^12.0.0",
    "solarlunar": "^3.1.0"
  },
  "devDependencies": {
    "vite-plus": "^0.3.0"
  }
}
